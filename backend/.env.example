# Copy the values you need into your shell or secret manager.
# Spring Boot does not load this file automatically. Never commit real keys.

# Server
SERVER_PORT=8081

# DashScope / Qwen. Empty chat key keeps the application in offline demo mode.
DASHSCOPE_API_KEY=
DASHSCOPE_STREAMING_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_STREAMING_BASE_URL=
DASHSCOPE_CHAT_MODEL=qwen-max
DASHSCOPE_STREAMING_CHAT_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_TEMPERATURE=0.3
DASHSCOPE_MAX_TOKENS=2048

# AI memory, tickets, concurrency and start-rate limits
AI_MAX_MEMORY_MESSAGES=20
AI_MAX_CONVERSATIONS=2000
AI_MAX_INPUT_CHARACTERS=4000
AI_STREAM_TIMEOUT=2m
AI_STREAM_TICKET_TTL=30s
AI_MAX_STREAM_TICKETS=2000
AI_MAX_PENDING_TICKETS_PER_OWNER=8
AI_MAX_CONCURRENT_REQUESTS=64
AI_MAX_CONCURRENT_REQUESTS_PER_OWNER=2
AI_MAX_STARTS_PER_MINUTE=300
AI_MAX_STARTS_PER_MINUTE_PER_OWNER=20

# Durable single-instance state; mount this directory on a persistent private volume.
APP_STORAGE_ENABLED=true
APP_DATA_DIR=./data

# Signed guest identity. Generate a stable production secret with:
# openssl rand -hex 32
APP_AUTH_TOKEN_SECRET=
APP_GUEST_TTL=12h
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
APP_SECURE_COOKIES=false
APP_COOKIE_SAME_SITE=Lax
# Keep false in production; true exposes the signed token in JSON for non-browser clients.
APP_EXPOSE_TOKEN=false

# Knowledge base ingestion and retrieval
RAG_LOCATION=classpath*:knowledge-base/*.md
RAG_MAX_RESULTS=4
# Vector-score threshold; BM25/RRF scores are not probabilities.
RAG_MIN_SCORE=0.05
# Measured local default; alternatives: vector, hybrid, hybrid_rerank.
RETRIEVAL_MODE=lexical
RETRIEVAL_BACKEND=memory
RETRIEVAL_EMBEDDING_VERSION=v1
RETRIEVAL_EMBEDDING_RETRY_BACKOFF=30s
RETRIEVAL_CANDIDATES=25
RETRIEVAL_RRF_K=60
RETRIEVAL_POSTGRES_URL=jdbc:postgresql://localhost:5433/ai_code_helper
RETRIEVAL_POSTGRES_USERNAME=ai_code_helper
RETRIEVAL_POSTGRES_PASSWORD=
# Built-in heuristic; choose http-cross-encoder for a separately deployed service.
RETRIEVAL_RERANKER_TYPE=deterministic-token-overlap
RETRIEVAL_RERANKER_URL=
RETRIEVAL_RERANKER_API_KEY=
RETRIEVAL_RERANKER_TIMEOUT=2s

# Provider deadlines and physical in-flight capacity (shared chat/stream/embedding).
AI_PROVIDER_CHAT_TIMEOUT=45s
AI_PROVIDER_EMBEDDING_TIMEOUT=20s
AI_PROVIDER_FIRST_TOKEN_TIMEOUT=15s
AI_PROVIDER_STREAM_TIMEOUT=90s
AI_PROVIDER_MAX_IN_FLIGHT=16
# Bounded FIFO admission; waiting counts against the model deadline. Zero disables waiting.
AI_PROVIDER_MAX_QUEUED=48
AI_PROVIDER_QUEUE_TIMEOUT=2s

# Bounded tool runtime; independent of model-provider deadlines.
MAX_AGENT_STEPS=6
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT=10s
MAX_TOTAL_TOOL_TIME=30s
MAX_CALLS_PER_TOOL=3

# Optional local diagnostics; ALL evaluation routes require the configured key.
APP_EVALUATION_ENABLED=false
APP_EVALUATION_KEY=

# Compose enables tracing and structured logs; standalone tracing is opt-in.
APP_TRACING_ENABLED=false
APP_TRACE_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Set to logstash for structured JSON logs.
LOGGING_STRUCTURED_FORMAT_CONSOLE=

# Optional BigModel MCP web search. It remains offline unless explicitly enabled.
BIGMODEL_MCP_ENABLED=false
BIGMODEL_API_KEY=
BIGMODEL_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
BIGMODEL_MCP_ALLOWED_TOOLS=webSearchPrime,web_search_prime
BIGMODEL_MCP_TIMEOUT=8s
BIGMODEL_MCP_RETRY_BACKOFF=30s

# Optional Jsoup interview-question tool
INTERVIEW_SEARCH_URL=https://www.nowcoder.com/search
INTERVIEW_CONNECT_TIMEOUT=4s
