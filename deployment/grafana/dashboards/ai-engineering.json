{
  "uid": "ai-engineering",
  "title": "AI Engineering \u00b7 Requests, Retrieval and Tools",
  "tags": [
    "ai-code-helper",
    "engineering"
  ],
  "schemaVersion": 41,
  "version": 2,
  "refresh": "10s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "AI requests / second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, status) (rate(ai_requests_total[$__rate_interval]))",
          "legendFormat": "{{mode}} \u00b7 {{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "AI failure ratio",
      "description": "Errors, timeouts and rejected requests; cancelled streams are shown separately in request rates.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(ai_requests_total{status=~\"error|timeout|rejected\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(ai_requests_total[$__rate_interval])), 0.000001)",
          "legendFormat": "failed / all"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "AI request latency \u00b7 p50 / p95",
      "description": "Server request lifetime; p95 is meaningful only with enough samples. SSE includes the full stream lifetime.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(ai_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{mode}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(ai_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{mode}} p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
